<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UETM2.ConfiguratorWindow"
        Title="Конфигуратор УЭТМ" Width="1600" Height="800"
        WindowStartupLocation="CenterScreen" CanResize="False"
		Icon="\logo\icon.png"
        Background="LightBlue">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="150"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="220"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="39"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Grid.ColumnSpan="3" Background="LightGray" BorderBrush="Black" BorderThickness="1">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<Menu Grid.Column="0" Background="Transparent">
					<MenuItem Header="Справка" Click="helpMenu_Click"/>
					<MenuItem Header="Руководство пользователя" Click="UserHelp_Click"/>
				</Menu>
				<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="50">
					<Button x:Name="btnChangePassword" Content="Изменить пароль" Click="btnChangePassword_Click"/>
					<Button x:Name="btnWrite" Content="Записать" Click="BtnWrite_Click"/>
				</StackPanel>
				<TextBlock Grid.Column="2" Text="Устройства" VerticalAlignment="Center" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,0,75,0"/>
			</Grid>
		</Border>

		<Border Grid.Row="1" Grid.Column="0" Background="LightGray"
                BorderBrush="Black" BorderThickness="1,0,1,0" Padding="4">
			<StackPanel Spacing="6">
				<Button Content="Управление" Click="BtnManagement_Click" HorizontalAlignment="Stretch"/>
				<Button x:Name="btnSettings" Content="Настройки +" Click="BtnSettings_Click" HorizontalAlignment="Stretch"/>
				<Button x:Name="btnGeneral" Content="Общие" IsVisible="False" Click="BtnGeneral_Click" HorizontalAlignment="Right" Width="100"/>
				<Button x:Name="btnNetwork" Content="Сетевые" IsVisible="False" Click="BtnNetwork_Click" HorizontalAlignment="Right" Width="100"/>
				<Button Content="Журнал" Click="BtnJournal_Click" HorizontalAlignment="Stretch"/>
			</StackPanel>
		</Border>

		<ContentControl Grid.Row="1" Grid.Column="1" x:Name="ChildFormPanel"/>

		<Border Grid.Row="1" Grid.Column="2" Background="LightGray"
                BorderBrush="Black" BorderThickness="1,0,1,0" Padding="4">
			<ScrollViewer>
				<StackPanel x:Name="devicesPanel" Spacing="6"/>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>