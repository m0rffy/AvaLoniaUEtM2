<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UETM2.SetTimeDialog"
        Title="Выберите дату и время" Width="320" Height="150"
        WindowStartupLocation="CenterScreen" CanResize="False"
        Background="Gainsboro">
    <StackPanel Margin="10" Spacing="10">
        <DatePicker x:Name="datePicker" Width="300" />
        <TimePicker x:Name="timePicker" ClockIdentifier="24HourClock" Width="300"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,10,0,0">
            <Button Content="Применить" Click="btnOk_Click" Width="90" />
            <Button Content="Отмена" Click="btnCancel_Click" Width="70" />
        </StackPanel>
    </StackPanel>
</Window>